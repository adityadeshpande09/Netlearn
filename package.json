{
  "name": "netlearn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm check:deployment && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "node scripts/test-browser.mjs guest",
    "test:accounts": "node scripts/test-browser.mjs accounts",
    "check:deployment": "node --experimental-strip-types scripts/check-deployment.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@xyflow/react": "12.11.6",
    "lucide-react": "1.43.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": {
    "pnpm": "11.19.0",
    "node": "^22.13.0 || ^24.0.0"
  }
}
